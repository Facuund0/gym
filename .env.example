# Copiá este archivo a .env.local y completalo. En Vercel cargá las mismas
# variables en Project → Settings → Environment Variables.

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GYM_NAME="Gualda Training"
NEXT_PUBLIC_GYM_SHORT_NAME=Gualda

# --- Supabase (Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Secreta: solo servidor (invitar alumnos, push masivo, guardar reglas de IA). Nunca con NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
# Para `npm run db:types`
SUPABASE_PROJECT_ID=xxxxxxxx

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Límites diarios por usuario
AI_RULES_PER_DAY_COACH=30
AI_RULES_PER_DAY_STUDENT=5
AI_REVIEWS_PER_DAY=10

# --- Firebase Cloud Messaging (Configuración del proyecto → General / Cloud Messaging) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=xxxx.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Cloud Messaging → Certificados push web → par de claves
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Cuentas de servicio → Generar nueva clave privada → el JSON pasado a base64:
#   macOS/Linux: base64 -w0 service-account.json   (en macOS: base64 -i service-account.json)
#   Windows PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
FIREBASE_SERVICE_ACCOUNT_BASE64=

# --- MediaPipe (opcional: alojar el modelo y el WASM en /public para no depender de CDNs) ---
# NEXT_PUBLIC_POSE_MODEL_URL=/models/pose_landmarker_lite.task
# NEXT_PUBLIC_MEDIAPIPE_WASM_URL=/mediapipe/wasm
